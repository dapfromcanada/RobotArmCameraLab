# camera_lab environment overrides. Copy to .env if needed (.env is git-ignored).
# No secrets are needed by this app. All values are optional.

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default INFO). The CLI flag --log-level wins.
CAMERA_LAB_LOG_LEVEL=

# Run-record root (default: <WS>/data/raw_recordings/camera_lab). Mainly for tests.
CAMERA_LAB_DATA_ROOT=

# Workspace root (default: /mnt/workspaces/robotic_cell). Mainly for tests.
CAMERA_LAB_WS_ROOT=

# Lock-file folder (default: /run/user/<uid>/camera_lab, else /tmp/camera_lab-<uid>). Tests only:
# every program driving a camera must use the same folder, or two can open one camera.
CAMERA_LAB_LOCK_DIR=
